# Raw data (fetched from UCI, not committed)
data/raw/

# Private artifacts (signing keys, anything under private/) — never committed.
# The private signing key lives outside the checkout and is supplied through
# NIGHTINGALE_SIGNING_KEY; `keys/` matches a directory of that name at any
# depth, so a key directory copied into the checkout is ignored too. The
# public half of the signing keypair is the one committed .pem.
private/
keys/
*.pem
!provenance/pubkey.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Node (dashboard tooling)
node_modules/

# Editors
.vscode/
.idea/
