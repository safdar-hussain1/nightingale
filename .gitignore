# Raw data (fetched from UCI, not committed)
data/raw/

# Private artifacts (signing keys, handbook) — never committed.
# `keys/` matches a directory of that name at any depth, which covers the
# out-of-checkout key directory this project signs from; the public half of
# the signing keypair is the one committed .pem.
private/
keys/
*.pem
!provenance/pubkey.pem

